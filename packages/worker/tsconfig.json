{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "dist",
    "rootDir": "..",
    "types": ["@cloudflare/workers-types"],
    "paths": {
      "@bookkeeper/shared": ["../shared/src"]
    }
  },
  "include": ["src", "../shared/src"]
}
