name = "bookkeeper-api"
main = "src/index.ts"
compatibility_date = "2024-07-22"

[[d1_databases]]
binding = "DB"
database_name = "bookkeeper-db"
database_id = "your-d1-database-id-here"

[[r2_buckets]]
binding = "R2"
bucket_name = "bookkeeper-attachments"

[vars]
JWT_SECRET = ""

[triggers]
crons = ["0 0 * * *"]
